# Local development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# TEMPORARY — HF direct API (default). Browser → backend with Bearer + localStorage.
# Leave unset/false. To restore BFF cookie hop: set true and rebuild the portal Space.
# NEXT_PUBLIC_PORTAL_USE_BFF=true

# Production (HF Space Variables — not this file).
# https://huggingface.co/spaces/iclubmedasu/members-portal → Settings → Variables
#   NEXT_PUBLIC_API_URL=https://iclubmedasu-backend.hf.space/api
#     Default: browser calls this URL directly (Bearer). Same as public website.
#   NEXT_PUBLIC_PORTAL_USE_BFF=true
#     Optional rebuild flag. When true, browser remaps to same-origin /backend-api (BFF).
#   BACKEND_API_URL=https://iclubmedasu-backend.hf.space   (runtime; needed only if BFF on)
#   NEXT_PUBLIC_BACKEND_ORIGIN=https://iclubmedasu-backend.hf.space  (optional; WebSockets)
#   BFF_PROXY_SECRET=<same value as backend Space>
#     Runtime. Required when BFF is on so Express trusts X-Iclub-Client-Ip.
#     Keep set for easy BFF reversal even while direct mode is default.

# Optional local: same secret as backend/.env when testing BFF client-IP rate keys.
# BFF_PROXY_SECRET=replace-with-a-long-random-shared-secret

# For LAN mobile testing, use your machine IP (example):
# NEXT_PUBLIC_API_URL=http://192.168.1.9:3000/api

# Public website base URL (used for copying shareable event links)
NEXT_PUBLIC_PUBLIC_WEBSITE_URL=http://localhost:3002
# Optional — copy link also uses backend PUBLIC_WEBSITE_URL when unset.
# Production (HF): NEXT_PUBLIC_PUBLIC_WEBSITE_URL=https://iclubmedasu-public-website.hf.space
# Future (HF custom domains — deferred): NEXT_PUBLIC_PUBLIC_WEBSITE_URL=https://iclubmedasu.com
# Future (deferred): NEXT_PUBLIC_API_URL=https://api.iclubmedasu.com/api

# Web Push VAPID public key (same value as backend VAPID_PUBLIC_KEY).
# Generate both keys with: npx web-push generate-vapid-keys
# Push only works in production builds (next-pwa is disabled in development).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
