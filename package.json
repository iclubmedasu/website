{
    "name": "iclub-platform",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@10.0.0",
    "workspaces": [
        "backend",
        "members-portal",
        "public-website",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter members-portal dev\" \"pnpm --filter public-website dev\"",
        "dev:portal": "pnpm --filter members-portal dev",
        "dev:api": "pnpm --filter @iclub/shared build && pnpm --filter backend dev",
        "dev:web": "pnpm --filter public-website dev",
        "dev:migration": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter members-portal dev\" \"pnpm --filter public-website dev\"",
        "dev:legacy": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter members-portal dev\"",
        "clean": "rimraf **/node_modules **/.next **/dist **/build",
        "build": "pnpm --filter @iclub/shared build && pnpm --filter backend build && pnpm --filter members-portal build && pnpm --filter public-website build",
        "build:portal": "pnpm --filter @iclub/shared build && pnpm --filter members-portal build",
        "build:api": "pnpm --filter @iclub/shared build && pnpm --filter backend build",
        "build:web": "pnpm --filter public-website build",
        "typecheck": "pnpm --filter backend typecheck && pnpm --filter members-portal typecheck && pnpm --filter public-website typecheck",
        "lint": "eslint . --ext .ts,.tsx",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
        "test": "vitest",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:coverage:ci": "vitest run --config vitest.config.ci.ts --coverage",
        "test:backend": "vitest run backend",
        "test:frontend": "vitest run members-portal packages/shared",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "datetime:audit": "node scripts/datetime-audit.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "@next/eslint-plugin-next": "^15.5.21",
        "@vitest/coverage-v8": "^3.2.7",
        "@vitest/ui": "^3.2.7",
        "concurrently": "^9.2.1",
        "eslint": "^9",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "jsdom": "^29.0.1",
        "prettier": "^3.8.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "rimraf": "^5.0.0",
        "supertest": "^7.1.4",
        "vitest": "^3.2.7"
    },
    "pnpm": {
        "overrides": {
            "serialize-javascript": "7.0.5",
            "esbuild": "0.25.0",
            "pg": "8.18.0",
            "shell-quote": ">=1.8.4",
            "nanoid": ">=3.3.17",
            "jspdf": ">=4.2.1",
            "hono": ">=4.12.34",
            "dompurify": ">=3.4.13",
            "fast-uri": ">=4.1.2",
            "postcss": ">=8.5.23",
            "brace-expansion@^1.0.0": "1.1.18",
            "brace-expansion@^2.0.0": "2.1.4",
            "js-yaml": ">=4.3.1",
            "form-data": ">=4.0.6",
            "ws": ">=8.21.0",
            "ip-address": ">=10.2.1",
            "multer": ">=2.2.0",
            "sharp": ">=0.34.5",
            "@hono/node-server": ">=1.19.13",
            "uuid": ">=13.0.1",
            "qs": ">=6.15.2",
            "valibot": ">=1.4.2",
            "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
            "@babel/core": ">=7.29.6 <8",
            "body-parser": ">=2.3.0",
            "vite": ">=6.4.3"
        },
        "auditConfig": {
            "ignoreGhsas": [
                "GHSA-4r6h-8v6p-xvw6",
                "GHSA-5pgg-2g8v-p4x9"
            ]
        },
        "onlyBuiltDependencies": [
            "@prisma/client",
            "@prisma/engines",
            "bcrypt",
            "esbuild",
            "prisma",
            "sharp",
            "unrs-resolver"
        ]
    }
}