###############################################################
# DATABASE
###############################################################
# Local db url (commented out)
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/iclubmedasu_db"
# Supabase / Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# For Github secret, use session pooler (5432) URL without `?pgbouncer=true`:
# When using the transaction pooler (6543) at runtime, Prisma needs to know it's behind a pooler.
# Example shape: postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

###############################################################
# AUTHENTICATION
###############################################################
# Required in production (server refuses to start without it when NODE_ENV=production)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

###############################################################
# APPLICATION (local dev)
###############################################################
PORT=3000
# PORT=7860 for HF Space Variables
NODE_ENV="development"

# Optional developer backdoor (both must be set to enable; leave unset in production)
# In production the backdoor stays disabled unless ALLOW_DEVELOPER_BACKDOOR=true
# DEVELOPER_EMAIL=you@example.com
# DEVELOPER_PASSWORD=replace-with-a-strong-password
# ALLOW_DEVELOPER_BACKDOOR=true

###############################################################
# EMAIL (RESEND)
###############################################################
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified domain/sender in Resend (not @gmail.com). Use onboarding@resend.dev for local testing only.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optional: replies go to this address when using a Resend test sender
RESEND_REPLY_TO=contact@example.com

# Public website base URL (used in ticket email confirmation links)
# Local: http://localhost:3002 | Production HF: https://iclubmedasu-public-website.hf.space
PUBLIC_WEBSITE_URL=http://localhost:3002

###############################################################
# CORS / FRONTEND ORIGINS
###############################################################
FRONTEND_URL=https://iclubmedasu-members-portal.hf.space
# Comma-separated extra allowed browser origins (members portal, public website, previews).
# Production no longer allows arbitrary *.hf.space — list every origin explicitly.
FRONTEND_ORIGINS=https://iclubmedasu-members-portal.hf.space,https://iclubmedasu-public-website.hf.space

###############################################################
# GITHUB FILE STORAGE (PROJECT FILES)
###############################################################
GITHUB_STORAGE_OWNER=your-org
GITHUB_STORAGE_REPO=file-storage
GITHUB_STORAGE_TOKEN=ghp_xxxxxxxx

###############################################################
# GITHUB USER DATA STORAGE (PROFILE PHOTOS)
###############################################################
GITHUB_USER_DATA_OWNER=your-org
GITHUB_USER_DATA_REPO=user-data
GITHUB_USER_DATA_TOKEN=ghp_xxxxxxxx

###############################################################
# SUPABASE CONFIGURATION (informational — baked into DATABASE_URL)
###############################################################
SUPABASE_PROJECT_NAME=members-portal
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_DB_PASSWORD=replace-me

###############################################################
# HUGGING FACE DEPLOY / CI (not loaded by the running API)
###############################################################
HF_SPACE_URL=your-backend.hf.space
HF_TOKEN=hf_xxxxxxxx
HF_SPACE=your-org/backend
HF_FRONTEND_SPACE=your-org/members-portal
HF_PUBLIC_SPACE=your-org/public-website
