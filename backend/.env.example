###############################################################
# DATABASE
###############################################################
# Local db url (commented out)
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/iclubmedasu_db"
# Supabase / Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# For Github secret, use session pooler (5432) URL without `?pgbouncer=true`:
# When using the transaction pooler (6543) at runtime, Prisma needs to know it's behind a pooler.
# Example shape: postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

###############################################################
# AUTHENTICATION
###############################################################
# Required in production (server refuses to start without it when NODE_ENV=production)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

###############################################################
# APPLICATION (local dev)
###############################################################
PORT=3000
# PORT=7860 for HF Space Variables
NODE_ENV="development"

# Optional developer backdoor (both must be set to enable; leave unset in production)
# In production the backdoor stays disabled unless ALLOW_DEVELOPER_BACKDOOR=true
# DEVELOPER_EMAIL=you@example.com
# DEVELOPER_PASSWORD=replace-with-a-strong-password
# ALLOW_DEVELOPER_BACKDOOR=true

###############################################################
# EMAIL (RESEND)
###############################################################
# Local and production both use Resend when these are set.
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified domain/sender in Resend (not @gmail.com).
# After iclubmedasu.com is Verified: noreply@iclubmedasu.com (use locally to test the domain).
# Fallback if domain not verified yet: onboarding@resend.dev (delivers mainly to your Resend account email).
RESEND_FROM_EMAIL=noreply@iclubmedasu.com
# RESEND_FROM_EMAIL=onboarding@resend.dev
# Replies go here (must actually receive mail — Resend is send-only).
RESEND_REPLY_TO=asu.medicine.iclub@gmail.com
# Max parallel Resend sends (tickets, reminders, certificates). Clamped 1–20; default 8.
EMAIL_SEND_CONCURRENCY=8

# Public website base URL (used in ticket/certificate email links)
# Local: http://localhost:3002
# Production (HF): https://iclubmedasu-public-website.hf.space
PUBLIC_WEBSITE_URL=http://localhost:3002

# Public API base URL (certificate PDF download links in emails)
# Local: http://localhost:3000/api
# Production (HF): https://iclubmedasu-backend.hf.space/api
API_PUBLIC_URL=http://localhost:3000/api

###############################################################
# WEB PUSH (VAPID)
###############################################################
# Generate with: npx web-push generate-vapid-keys
# Public key must match NEXT_PUBLIC_VAPID_PUBLIC_KEY in members-portal.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI for push services (mailto: or https:)
VAPID_SUBJECT=mailto:admin@example.com

###############################################################
# CORS / FRONTEND ORIGINS
###############################################################
# Members portal origin used in password-reset email links.
# Local: http://localhost:3001
# Production (HF): https://iclubmedasu-members-portal.hf.space
FRONTEND_URL=http://localhost:3001
# Comma-separated allowed browser origins. List every origin explicitly — arbitrary *.hf.space is not allowed.
FRONTEND_ORIGINS=http://localhost:3001,https://iclubmedasu-members-portal.hf.space,https://iclubmedasu-public-website.hf.space
# Future (HF custom domains — deferred; needs HF paid custom domains):
# FRONTEND_URL=https://members-portal.iclubmedasu.com
# FRONTEND_ORIGINS=...,https://members-portal.iclubmedasu.com,https://iclubmedasu.com,https://www.iclubmedasu.com
# PUBLIC_WEBSITE_URL=https://iclubmedasu.com
# API_PUBLIC_URL=https://api.iclubmedasu.com/api

###############################################################
# GITHUB FILE STORAGE (PROJECT FILES)
###############################################################
GITHUB_STORAGE_OWNER=your-org
GITHUB_STORAGE_REPO=file-storage
GITHUB_STORAGE_TOKEN=ghp_xxxxxxxx

###############################################################
# GITHUB USER DATA STORAGE (PROFILE PHOTOS)
###############################################################
GITHUB_USER_DATA_OWNER=your-org
GITHUB_USER_DATA_REPO=user-data
GITHUB_USER_DATA_TOKEN=ghp_xxxxxxxx

###############################################################
# SUPABASE CONFIGURATION (informational — baked into DATABASE_URL)
###############################################################
SUPABASE_PROJECT_NAME=members-portal
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_DB_PASSWORD=replace-me

###############################################################
# HUGGING FACE DEPLOY / CI (not loaded by the running API)
###############################################################
HF_SPACE_URL=your-backend.hf.space
HF_TOKEN=hf_xxxxxxxx
HF_SPACE=your-org/backend
HF_FRONTEND_SPACE=your-org/members-portal
HF_PUBLIC_SPACE=your-org/public-website
