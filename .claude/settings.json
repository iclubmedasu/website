{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(!*.example)",
      "Edit(.env*)",
      "Edit(!*.example)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(gh workflow run *)",
      "PowerShell(git push *)",
      "PowerShell(git push)",
      "PowerShell(gh workflow run *)"
    ]
  }
}
